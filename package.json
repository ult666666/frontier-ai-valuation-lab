{
  "name": "frontier-ai-valuation-lab",
  "version": "3.3.0",
  "private": true,
  "description": "A full stack valuation research workspace with exact thesis attribution, contextual evidence, portable research casebooks and a deterministic API.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:model": "node --test --test-isolation=none tests/model.test.js",
    "test:api": "node --test --test-isolation=none tests/api.test.js",
    "build": "node scripts/build.js",
    "verify": "npm test && npm run build"
  },
  "license": "MIT"
}
